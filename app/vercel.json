{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "https://weekcurve-api.onrender.com/app/:path*"
    },
    {
      "source": "/((?!app(?:/|$)).*)",
      "destination": "/_shell.html"
    }
  ]
}
