{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/internal/:path*",
      "destination": "https://weekcurve-api.onrender.com/internal/:path*"
    },
    {
      "source": "/((?!internal(?:/|$)).*)",
      "destination": "/_shell.html"
    }
  ]
}
